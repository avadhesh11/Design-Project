# Backend Environment Configuration Example
# Copy this file to .env or .env.local and fill in the values.
# NEVER commit .env or .env.local to version control!

# App & CORS
FRONTEND_URL=http://localhost:3000
PRODUCTION=False

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/nexusai

# Redis (Caching & Task Queues)
REDIS_URL=redis://localhost:6379/0

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# JWT & Authentication
JWT_SECRET=your-super-secret-jwt-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# AI Engine & Models (Gemini or Local Ollama/Llama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# GitHub OAuth App
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub App (Integrations & Webhooks)
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_ID=your-github-app-id
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_APP_PRIVATE_KEY_PATH=your-private-key.pem

# LangSmith / LangChain Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=your-langsmith-project-name

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
